# Pluggy credentials.
# Copy this file to `.env` (git-ignored) or export these in your shell /
# IDE run configuration. Never commit real values and never ship them
# to the browser: only the short-lived connect token may leave the server.
#
# Find both values in the Pluggy dashboard for the application
# (Development or Production) you want to use.
PLUGGY_CLIENT_ID=00000000-0000-0000-0000-000000000000
PLUGGY_CLIENT_SECRET=replace-with-your-real-secret

# Optional: only change if Pluggy gives you a different host.
# PLUGGY_BASE_URL=https://api.pluggy.ai

# Optional shared secret for POST /api/webhooks/pluggy (header X-Webhook-Token).
# PLUGGY_WEBHOOK_SECRET=

# Optional: the Pluggy item to use automatically when the bot starts.
# One item per connected bank. Get it from the widget onSuccess (itemData.item.id)
# or from the item/created webhook.
# PLUGGY_ITEM_ID=
# Optional display name for the connected bank/connector.
# PLUGGY_CONNECTOR_NAME=MeuPluggy

# OpenCode (LLM provider).
# Create the key in the OpenCode Console (https://opencode.ai/console).
# Never commit it and never send it to the browser.
OPENCODE_API_KEY=oc_sk_replace-with-your-key

# Default surface: OpenCode Go (workspace with a Go or Go Plus subscription).
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
#
# Pay-as-you-go Console inference instead (billed to the key's budget):
# OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1

# Optional: defaults to deepseek-v4.1-flash.
# OPENCODE_MODEL=deepseek-v4.1-flash

# Jev categorizer via TypeSafe System One (native API, not OpenCode).
# This is a TypeSafe API key, not an OpenCode key.
# Create the key at https://console.typesafe.ai/keys and paste it here.
CATEGORIZER_API_TOKEN=
# CATEGORIZER_MODEL=jev-latest
# CATEGORIZER_BASE_URL=https://api.typesafe.ai

# Telegram bot (long polling). Create it with @BotFather and keep the token
# out of git. The bot only replies to text in the MVP.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Numeric Telegram user ID allowed to use the bot.
# Get it from @userinfobot (it is not the username).
TELEGRAM_OWNER_ID=

# SQLite file used by the bot.
# DATABASE_PATH=myfinance.db

# Timezone used to resolve "hoje", "ontem" and "amanhã".
# TIMEZONE=America/Sao_Paulo
